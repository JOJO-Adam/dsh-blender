{
  "name": "@jojonadam/dsh-blender",
  "version": "0.1.2",
  "description": "Blender production pack for DeepSeek Harness: headless bpy runner, render/export helpers, modeling cookbook, 5.x pitfalls and procedural asset pipeline. 本地建模 · 零依赖客户端 · 5.2 LTS 校准。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "locale"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "blender",
    "bpy",
    "3d",
    "gltf",
    "procedural-assets"
  ],
  "license": "MIT",
  "author": "JOJO & Adam",
  "homepage": "https://jojo-adam.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JOJO-Adam/dsh-blender.git"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/JOJO-Adam/dsh-blender/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "icon.svg"
}
